# Valorile vin de la integrarea Turso din Vercel. Cel mai simplu le aduci cu:
#   npx vercel link
#   npx vercel env pull --environment=production .env
# Alternativ, copiaza fisierul in `.env` si completeaza manual valorile.
# Fara aceste variabile aplicatia foloseste automat baza SQLite locala
# din backend/data/hairit.db, deci pentru dezvoltare nu ai nevoie de ele.

TURSO_DATABASE_URL=libsql://numele-bazei-contul-tau.turso.io
TURSO_AUTH_TOKEN=token-generat-din-integrarea-vercel-sau-din-cli
